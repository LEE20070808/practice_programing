# Google Cloud ConsoleでOAuthクライアントIDを作成したらここに貼る
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain-or-ip/auth/google/callback

# セッションCookieの暗号化に使う適当な長いランダム文字列（自分で決めてOK）
SESSION_SECRET=change-this-to-a-random-string

# VPS上のPostgreSQLへの接続情報（作成したユーザー名・パスワード・DB名に置き換える）
DATABASE_URL=postgresql://codedrill_user:your-db-password@localhost:5432/codedrill

# サーバーをVPS上で常時稼働させる場合は production にする
NODE_ENV=production

# AIレビュー機能用（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
